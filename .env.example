# Cars & Coffee — Environment Configuration
# 1. Backend Database Engine (MySQL / PHP API vs Local Fallback)
# Set VITE_USE_PHP_API=true when running with a local Apache/XAMPP PHP + MySQL backend.
# On Swinburne Mercury (mercury.swin.edu.au), PHP + MySQL mode activates automatically.
VITE_USE_PHP_API=false
VITE_API_BASE_URL=./api/index.php

# 2. EmailJS (Optional — Browser Public Keys for Registration & RSVP Confirmation Emails)
VITE_EMAILJS_SERVICE_ID=service_n08hlvl
VITE_EMAILJS_TEMPLATE_ID=template_jzi2ddo
VITE_EMAILJS_PUBLIC_KEY=tp3fdMNcEg7OZTa9P

# 3. Optional External API Keys (Plug in when ready; free public APIs work out-of-the-box)
VITE_MAP_TILES_API_KEY=
VITE_WEATHER_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
